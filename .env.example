TP_TOKEN=
TP_BASE_URL=
TP_API_VERSION=v1

# Con be found with get_logged_in_user tool
TP_OWNER_ID=

# Con be found with 'get_projects' tool
TP_PROJECT_ID=

# Con be found with 'get_teams' tool
TP_TEAM_ID=

# Optional custom field used to store bug origin. Leave blank if project has no such field.
TP_BUG_ORIGIN_FIELD=

# Optional legacy workflow context; TP_PROJECT_ID can supply the process
# Can be found with 'get_processes' tool
TP_PROCESS_ID=
TP_USER_STORY_WORKFLOW_ID=
TP_BUG_WORKFLOW_ID=

# Request timeout (milliseconds, 1-300000), retries for reads only (0-5)
TP_REQUEST_TIMEOUT_MS=30000
TP_READ_RETRIES=2
# Metadata logging only; request bodies and secrets are never logged
TP_DEBUG=false
