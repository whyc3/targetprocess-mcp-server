    "@types/node": "^25.2.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.4",
    "fflate": "^0.8.3",
    "jsdom": "^28.0.0",
    "pdfjs-dist": "^6.4.299",
    "rimraf": "^6.1.2",
    "sharp": "^0.35.5",
    "shx": "^0.4.0",
    "tesseract.js": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
